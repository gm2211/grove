# Placeholder only. The fleet startup script (internal/fleet) overwrites this file at every VM
# boot with the real control-plane address and pool/host meta, e.g.:
#
#   client {
#     servers = ["grove-nomad.internal:4647"]
#     meta {
#       pool = "macos"
#       host = "mac-mini-1"
#     }
#     cpu_total_compute = 36000
#   }
#
# cpu_total_compute (macOS only) overrides Nomad's stock CPU fingerprint, which badly
# under-reports on Apple Silicon (see client.hcl's comment and docs/OPERATIONS.md "jobs pending
# with DimensionExhausted cpu on macOS"). The startup script computes it per boot from the guest's
# actual core count (ncpu * 2000 MHz) since it can't be a fixed value baked into this generic
# image — see docs/IMAGES.md's two-file config contract.
#
# Shipping a syntactically valid (but non-functional) file in the image means `nomad agent`
# never fails to start for lack of a servers stanza, even if the startup script hasn't run yet.
client {
  servers = []
  meta {
    pool = "unset"
    host = "unset"
  }
}
