+// Copyright IBM Corp. 2015, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+//go:build darwin
+
+package numalib
+
+import "testing"
+
+func TestNormalizeAppleSiliconCoreCounts(t *testing.T) {
+	tests := []struct {
+		name       string
+		pCores     int
+		eCores     int
+		fallback   uint32
+		wantPCores int
+		wantECores int
+	}{
+		{
+			name:       "single performance level in virtual guest",
+			pCores:     4,
+			eCores:     -1,
+			fallback:   4,
+			wantPCores: 4,
+			wantECores: 0,
+		},
+		{
+			name:       "missing P core count falls back to guest CPU total",
+			pCores:     -1,
+			eCores:     -1,
+			fallback:   4,
+			wantPCores: 4,
+			wantECores: 0,
+		},
+		{
+			name:       "missing P core count preserves known E cores",
+			pCores:     -1,
+			eCores:     4,
+			fallback:   8,
+			wantPCores: 4,
+			wantECores: 4,
+		},
+		{
+			name:       "valid hybrid topology is unchanged",
+			pCores:     8,
+			eCores:     4,
+			fallback:   12,
+			wantPCores: 8,
+			wantECores: 4,
+		},
+		{
+			name:       "unavailable fallback cannot create negative count",
+			pCores:     -1,
+			eCores:     -1,
+			fallback:   0,
+			wantPCores: 0,
+			wantECores: 0,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			pCores, eCores := normalizeAppleSiliconCoreCounts(tt.pCores, tt.eCores, tt.fallback)
+			if pCores != tt.wantPCores || eCores != tt.wantECores {
+				t.Fatalf("normalized core counts = (%d, %d), want (%d, %d)",
+					pCores, eCores, tt.wantPCores, tt.wantECores)
+			}
+		})
+	}
+}
