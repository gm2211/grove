@@ -63,6 +73,19 @@ func (m *MacOS) scanAppleSilicon(top *Topology) {
 	}
 }
 
+func normalizeAppleSiliconCoreCounts(pCoreCount, eCoreCount int, fallbackCPUCount uint32) (int, int) {
+	if eCoreCount < 0 {
+		eCoreCount = 0
+	}
+	if pCoreCount <= 0 {
+		pCoreCount = int(fallbackCPUCount) - eCoreCount
+		if pCoreCount < 0 {
+			pCoreCount = 0
+		}
+	}
+	return pCoreCount, eCoreCount
+}
